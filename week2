          ]
        }
      ],
      "source": [
        "num=int(input(\"enter the number\"))\n",
        "match num:\n",
        "\n",
        "  case 1:\n",
        "    print(\"sunday\")\n",
        "  case 2:\n",
        "    print(\"monday\")\n",
        "  case 3:\n",
        "   print(\"tuesday\")\n",
        "  case 4:\n",
        "   print(\"wednesday\")\n",
        "  case 5:\n",
        "   print(\"thursday\")\n",
        "  case 6:\n",
        "   print(\"friday\")\n",
        "  case 7:\n",
        "    print(\"saturday\")\n",
        "  case _:\n",
        "    print(\"invalid\")\n",
        "\n"
      ]
    },
