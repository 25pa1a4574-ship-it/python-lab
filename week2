        "   print(\"thursday\")\n",
        "  case 6:\n",
        "   print(\"friday\")\n",
        "  case 7:\n",
        "    print(\"saturday\")\n",
        "  case _:\n",
        "    print(\"invalid\")\n",
        "\n"
      ]
